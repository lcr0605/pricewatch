# 실제 값은 .env에 넣는다 (.env는 저장소에 올라가지 않음)

# Supabase > Connect > Connection String > Session pooler (포트 5432)
DATABASE_URL=postgresql://postgres.프로젝트ID:DB비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# 2주차: 텔레그램 알림
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 3주차: 대시보드 로그인
APP_PASSWORD=
# 로그인 세션 서명 키 (아무 긴 무작위 문자열). 없으면 서버 재시작 시 로그아웃됨
SESSION_SECRET=
